# Server secrets. Never place these in extension files.
MONGODB_URI=mongodb+srv://DATABASE_USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=clearspace
HIVE_API_KEY=
HIVE_ENDPOINT=https://api.thehive.ai/api/v3/chat/completions
RATE_LIMIT_SECRET=
PUBLIC_ACCESS=false
ACCESS_TOKEN_HASHES=[]
GLOBAL_AI_DAILY_LIMIT=50
CORS_ORIGINS=chrome-extension://YOUR_PUBLISHED_EXTENSION_ID
HOST=127.0.0.1
PORT=8000
# Trust only nginx's actual connection IP; leave blank for direct hosting.
TRUST_PROXY=127.0.0.1,::1
