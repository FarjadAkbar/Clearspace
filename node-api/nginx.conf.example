# Include inside the existing TLS virtual host for clearspace.decentgatewaysllc.com.
client_max_body_size 6m;
client_body_timeout 15s;
location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    # Overwrite any forwarded headers supplied by the caller.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 55s;
    # Avoid request URLs/token leakage in access logs for these APIs.
    access_log off;
}
